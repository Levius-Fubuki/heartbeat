# 复制为 .env 并填入你的 key(.env 已在 .gitignore,不会被提交)

# ---- LLM(必需,OpenAI 兼容接口)----
# DeepSeek: https://platform.deepseek.com 申请
HEARTBEAT_LLM_API_KEY=sk-替换为你的Key
HEARTBEAT_LLM_BASE_URL=https://api.deepseek.com
HEARTBEAT_LLM_MODEL=deepseek-chat

# ---- 联网搜索工具(可选)----
# Tavily: https://tavily.com 申请;留空则 web_search 工具不可用
# HEARTBEAT_TAVILY_KEY=

# ---- 语音 TTS / CosyVoice2 声音克隆(可选)----
# 硅基流动: https://siliconflow.cn 申请;留空则 cosyvoice 引擎不可用(可在设置页改用 edge / azure)
# HEARTBEAT_SILICONFLOW_KEY=
# HEARTBEAT_SILICONFLOW_TTS_URL=https://api.siliconflow.cn/v1/audio/speech
# HEARTBEAT_SILICONFLOW_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B

# ---- Phase 4 ReAct + 向量召回(可选,不填走默认)----
# HEARTBEAT_EMBED_MODEL=BAAI/bge-small-zh-v1.5   # 本地中文嵌入模型(fastembed ONNX,首次下载 ~130MB)
# HEARTBEAT_RECALL_TOP_K=3                        # recall_memory 返回条数
# HEARTBEAT_REACT_MAX_ROUNDS=4                    # ReAct 循环上限
# HEARTBEAT_TOOL_INCLUDE_WINDOW_TITLE=1           # 设 0 关掉 get_activity 返回窗口标题(隐私优先)
# HEARTBEAT_EMBED_ENABLED=1                        # 设 0 完全关掉向量召回(降级到纯 recent_text)
